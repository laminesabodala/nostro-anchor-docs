{
  "theme": "mint",
  "name": "Nostro Anchor API",
  "colors": {
    "primary": "#2855FF",
    "light": "#4671FF",
    "dark": "#1940D5"
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "interactive",
      "proxy": false
    },
    "examples": {
      "languages": [
        "curl",
        "javascript"
      ],
      "prefill": true
    }
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Run a payment",
      "href": "/quickstart"
    }
  },
  "footer": {
    "socials": {}
  },
  "contextual": {
    "options": [
      "copy",
      "view",
      "chatgpt",
      "claude",
      "perplexity",
      "mcp",
      "cursor",
      "vscode"
    ],
    "display": "header"
  },
  "$schema": "https://mintlify.com/docs.json",
  "navigation": {
    "tabs": [
      {
        "tab": "Start here",
        "groups": [
          {
            "group": "Sandbox demonstration",
            "pages": [
              "index",
              "quickstart"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "/openapi.json",
        "groups": [
          {
            "group": "1. Authenticate",
            "pages": [
              "GET /auth",
              "POST /auth"
            ]
          },
          {
            "group": "2. Register customers",
            "pages": [
              "PUT /sep12/customer",
              "GET /sep12/customer"
            ]
          },
          {
            "group": "3. Get a firm quote",
            "pages": [
              "POST /sep38/quote"
            ]
          },
          {
            "group": "4. Create and track payment",
            "pages": [
              "POST /sep31/transactions",
              "GET /sep31/transactions/{id}"
            ]
          },
          {
            "group": "Additional endpoints",
            "pages": [
              "GET /.well-known/stellar.toml",
              "GET /sep31/info",
              "GET /sep38/info",
              "GET /sep38/prices",
              "GET /sep38/price",
              "GET /sep38/quote/{quote_id}"
            ]
          }
        ]
      }
    ]
  }
}
