{
  "theme": "mint",
  "name": "Nostro Anchor API",
  "colors": {
    "primary": "#2855FF",
    "light": "#4671FF",
    "dark": "#1940D5"
  },
  "api": {
    "openapi": "openapi.json",
    "playground": {
      "display": "interactive",
      "proxy": true
    },
    "examples": {
      "languages": [
        "curl",
        "javascript"
      ],
      "prefill": true
    }
  },
  "navbar": {
    "links": [],
    "primary": {
      "type": "button",
      "label": "Run a payment",
      "href": "/quickstart"
    }
  },
  "footer": {
    "socials": {}
  },
  "contextual": {
    "options": [
      "copy",
      "view"
    ],
    "display": "header"
  },
  "$schema": "https://mintlify.com/docs.json",
  "navigation": {
    "tabs": [
      {
        "tab": "Start here",
        "groups": [
          {
            "group": "Sandbox demonstration",
            "pages": [
              "index",
              "quickstart",
              "test-beneficiaries",
              "limits-and-errors",
              "about-sandbox",
              "curl-walkthrough"
            ]
          }
        ]
      },
      {
        "tab": "API reference",
        "openapi": "/openapi.json",
        "groups": [
          {
            "group": "1. Session",
            "pages": [
              "POST /sandbox/auth"
            ]
          },
          {
            "group": "2. Customers",
            "pages": [
              "PUT /sep12/customer",
              "GET /sep12/customer"
            ]
          },
          {
            "group": "3. Quotes",
            "pages": [
              "POST /sep38/quote",
              "GET /sep38/quote/{quote_id}"
            ]
          },
          {
            "group": "4. Payments",
            "pages": [
              "POST /sep31/transactions"
            ]
          },
          {
            "group": "5. Funding",
            "pages": [
              "POST /sandbox/payments/{id}/fund"
            ]
          },
          {
            "group": "6. Tracking",
            "pages": [
              "GET /sep31/transactions/{id}"
            ]
          },
          {
            "group": "Optional reference",
            "pages": [
              "GET /.well-known/stellar.toml",
              "GET /auth",
              "POST /auth",
              "GET /sep31/info",
              "GET /sep38/info",
              "GET /sep38/prices",
              "GET /sep38/price"
            ]
          }
        ]
      }
    ]
  }
}
